QPlainTextEdit#licenseTextView {
  color: #f5f5f5;
  background: #111111;
  border-top: 2px solid #050505;
  border-left: 2px solid #050505;
  border-right: 2px solid #5c5c5c;
  border-bottom: 2px solid #5c5c5c;
  border-radius: 0px;
  padding: 10px;
  font-family: "Kaisei Opti", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  font-size: 12px;
  selection-background-color: #4c7f2a;
}

QCheckBox#consentCheckbox {
  color: #ffffff;
  font-size: 13px;
  font-weight: 800;
  spacing: 8px;
}

QCheckBox#consentCheckbox::indicator {
  width: 18px;
  height: 18px;
  border-top: 2px solid #050505;
  border-left: 2px solid #050505;
  border-right: 2px solid #5c5c5c;
  border-bottom: 2px solid #5c5c5c;
  background: #111111;
}

QCheckBox#consentCheckbox::indicator:checked {
  background: #4c7f2a;
}

QCheckBox#consentCheckbox::indicator:disabled {
  background: #1a1a1a;
  border-color: #3a3a3a;
}

QWidget#licenseButtonRow {
  background: transparent;
}
