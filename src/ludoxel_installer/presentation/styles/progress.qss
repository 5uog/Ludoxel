QLabel#progressStageLabel {
  color: #ffffff;
  font-size: 15px;
  font-weight: 800;
}

QLabel#progressDetailLabel {
  color: rgba(255, 255, 255, 180);
  font-size: 12px;
}

QLabel#progressDetailLabel[state="error"] {
  color: #e0654a;
}

QProgressBar#installerProgressBar {
  color: #ffffff;
  background: #111111;
  border-top: 2px solid #050505;
  border-left: 2px solid #050505;
  border-right: 2px solid #5c5c5c;
  border-bottom: 2px solid #5c5c5c;
  border-radius: 0px;
  text-align: center;
  font-size: 12px;
  font-weight: 800;
  min-height: 22px;
}

QProgressBar#installerProgressBar::chunk {
  background: #8bc45a;
  border-top: 1px solid #b8e884;
  border-left: 1px solid #b8e884;
  border-right: 1px solid #2b4519;
  border-bottom: 1px solid #2b4519;
}

QPlainTextEdit#uninstallDetailView {
  color: #f5f5f5;
  background: #111111;
  border-top: 2px solid #050505;
  border-left: 2px solid #050505;
  border-right: 2px solid #5c5c5c;
  border-bottom: 2px solid #5c5c5c;
  border-radius: 0px;
  padding: 10px;
  font-family: "Kaisei Opti", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  font-size: 13px;
  selection-background-color: #4c7f2a;
}

QLabel#retentionNoticeLabel {
  color: rgba(255, 255, 255, 205);
  background: #303030;
  border-top: 3px solid #5b5b5b;
  border-left: 3px solid #5b5b5b;
  border-right: 3px solid #111111;
  border-bottom: 3px solid #111111;
  padding: 10px 12px;
  font-size: 12px;
}
