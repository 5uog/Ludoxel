/* Ludoxel base chrome: main window surface and tooltips. */

QMainWindow {
  background: #101010;
}

QWidget#gameScreen,
QFrame#loadingOverlay {
  background: #121212;
}

QLabel#loadingTitle {
  color: #f4f4f4;
  font-size: 28px;
  font-weight: 700;
}

QLabel#loadingStatus {
  color: #c8c8c8;
  font-size: 14px;
}

QToolTip {
  color: #ffffff;
  background: #1e1e1e;
  border-top: 2px solid #5f5f5f;
  border-left: 2px solid #5f5f5f;
  border-right: 2px solid #0a0a0a;
  border-bottom: 2px solid #0a0a0a;
  padding: 6px 8px;
}
