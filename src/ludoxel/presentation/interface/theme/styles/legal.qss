QWidget#settingsRoot QWidget#legalPage,
QWidget#othelloSettingsRoot QWidget#legalPage,
QWidget#settingsDialog QWidget#legalPage {
  background: #242424;
  border: none;
}

QWidget#settingsRoot QListWidget#legalMaterialList,
QWidget#othelloSettingsRoot QListWidget#legalMaterialList,
QWidget#settingsDialog QListWidget#legalMaterialList {
  color: #f5f5f5;
  background: #111111;
  border-top: 2px solid #050505;
  border-left: 2px solid #050505;
  border-right: 2px solid #5c5c5c;
  border-bottom: 2px solid #5c5c5c;
  border-radius: 0px;
  font-size: 13px;
}

QWidget#settingsRoot QListWidget#legalMaterialList::item,
QWidget#othelloSettingsRoot QListWidget#legalMaterialList::item,
QWidget#settingsDialog QListWidget#legalMaterialList::item {
  padding: 6px 8px;
}

QWidget#settingsRoot QListWidget#legalMaterialList::item:selected,
QWidget#othelloSettingsRoot QListWidget#legalMaterialList::item:selected,
QWidget#settingsDialog QListWidget#legalMaterialList::item:selected {
  background: #4c7f2a;
  color: #ffffff;
}

QWidget#settingsRoot QPlainTextEdit#legalTextView,
QWidget#othelloSettingsRoot QPlainTextEdit#legalTextView,
QWidget#settingsDialog QPlainTextEdit#legalTextView {
  color: #f5f5f5;
  background: #111111;
  border-top: 2px solid #050505;
  border-left: 2px solid #050505;
  border-right: 2px solid #5c5c5c;
  border-bottom: 2px solid #5c5c5c;
  border-radius: 0px;
  padding: 10px;
  font-family: "Consolas", "Menlo", monospace;
  font-size: 12px;
}
