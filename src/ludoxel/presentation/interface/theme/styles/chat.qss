QWidget#chatScreenRoot {
  background: rgba(0, 0, 0, 150);
}

QFrame#chatTitleBar {
  background: #2a2a2a;
  border-bottom: 3px solid #0b0b0b;
}

QFrame#chatBottomBar {
  background: #2a2a2a;
  border-top: 3px solid #0b0b0b;
}

QLabel#chatTitleLabel {
  color: #ffffff;
  font-size: 18px;
  font-weight: 700;
}

QWidget#chatCentral {
  background: transparent;
}

QWidget#chatLogText {
  background: transparent;
}

QScrollArea#chatLogScroll {
  background: transparent;
  border: none;
}

QWidget#chatFeedRoot {
  background: rgba(0, 0, 0, 110);
  border: 2px solid #0b0b0b;
  border-radius: 4px;
}

QWidget#chatFeedText {
  background: transparent;
}

QWidget#chatCandidateView {
  background: rgba(0, 0, 0, 90);
}

QLabel#chatCandidateRow {
  color: #d6d6d6;
  font-size: 14px;
  padding: 4px 8px;
  background: rgba(20, 20, 20, 160);
  border-left: 3px solid #6fb03a;
}

QLabel#chatCandidateRow[selected="true"] {
  color: #ffffff;
  background: rgba(70, 112, 36, 205);
  border-left-color: #a7e16d;
}

QLineEdit#chatInput {
  background: #1c1c1c;
  color: #ffffff;
  border-top: 2px solid #0b0b0b;
  border-left: 2px solid #0b0b0b;
  border-right: 2px solid #4a4a4a;
  border-bottom: 2px solid #4a4a4a;
  padding: 0px 8px;
  min-height: 0px;
  selection-background-color: #6fb03a;
  selection-color: #0b0b0b;
}

QLineEdit#chatInput:focus {
  border-top: 2px solid #6fb03a;
  border-left: 2px solid #6fb03a;
}

QPushButton#chatBackButton,
QPushButton#chatSettingsButton {
  background: #3a3a3a;
  color: #ffffff;
  font-weight: 700;
  border-top: 3px solid #6f6f6f;
  border-left: 3px solid #6f6f6f;
  border-right: 3px solid #0b0b0b;
  border-bottom: 3px solid #0b0b0b;
}

QPushButton#chatBackButton:hover,
QPushButton#chatSettingsButton:hover {
  background: #474747;
}

QPushButton#chatBackButton:pressed,
QPushButton#chatSettingsButton:pressed {
  background: #2f2f2f;
  border-top: 3px solid #0b0b0b;
  border-left: 3px solid #0b0b0b;
  border-right: 3px solid #6f6f6f;
  border-bottom: 3px solid #6f6f6f;
}

QPushButton#chatBackButton:disabled,
QPushButton#chatSettingsButton:disabled {
  color: rgba(255,255,255,115);
  background: #444444;
  border-top-color: #606060;
  border-left-color: #606060;
  border-right-color: #222222;
  border-bottom-color: #222222;
}

QPushButton#chatSettingsButton {
  padding: 6px;
}

QWidget#chatScreenRoot QScrollBar:vertical {
  width: 14px;
  background: #111111;
  border-left: 2px solid #080808;
  margin: 0px;
}

QWidget#chatScreenRoot QScrollBar::handle:vertical {
  min-height: 30px;
  background: #5a5a5a;
  border-top: 2px solid #8a8a8a;
  border-left: 2px solid #8a8a8a;
  border-right: 2px solid #202020;
  border-bottom: 2px solid #202020;
}

QWidget#chatScreenRoot QScrollBar::handle:vertical:hover {
  background: #6a6a6a;
}

QWidget#chatScreenRoot QScrollBar::handle:vertical:pressed {
  background: #505050;
  border-top-color: #777777;
  border-left-color: #777777;
  border-right-color: #1c1c1c;
  border-bottom-color: #1c1c1c;
}

QWidget#chatScreenRoot QScrollBar::add-line:vertical,
QWidget#chatScreenRoot QScrollBar::sub-line:vertical {
  height: 0px;
  background: transparent;
  border: none;
}

QWidget#chatScreenRoot QScrollBar::add-page:vertical,
QWidget#chatScreenRoot QScrollBar::sub-page:vertical {
  background: transparent;
}

QWidget#chatSettingsRoot {
  background: rgba(0, 0, 0, 120);
}

QFrame#chatSettingsPanel {
  background: #2a2a2a;
  border-top: 4px solid #666666;
  border-left: 4px solid #666666;
  border-right: 4px solid #0b0b0b;
  border-bottom: 4px solid #0b0b0b;
}

QLabel#chatSettingsTitle {
  color: #ffffff;
  font-size: 20px;
  font-weight: 800;
}

QWidget#chatSettingsRoot QLabel#settingsRowLabel {
  color: #ffffff;
  font-size: 15px;
}
