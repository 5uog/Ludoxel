QWidget#settingsDialog QDoubleSpinBox:hover {
  background: #181818;
  border-right-color: #707070;
  border-bottom-color: #707070;
}

QDialog#playerNameDialog QLineEdit#playerNameEdit:focus,
QWidget#settingsRoot QLineEdit:focus,
QWidget#othelloSettingsRoot QLineEdit:focus,
QWidget#settingsDialog QLineEdit:focus,
QWidget#inventoryRoot QLineEdit:focus,
QWidget#settingsRoot QComboBox:focus,
QWidget#othelloSettingsRoot QComboBox:focus,
QWidget#settingsDialog QComboBox:focus,
QWidget#settingsRoot QSpinBox:focus,
QWidget#settingsRoot QDoubleSpinBox:focus,
QWidget#othelloSettingsRoot QSpinBox:focus,
QWidget#othelloSettingsRoot QDoubleSpinBox:focus,
QWidget#settingsDialog QSpinBox:focus,
QWidget#settingsDialog QDoubleSpinBox:focus {
  border-top-color: #d7ff9b;
  border-left-color: #d7ff9b;
  border-right-color: #d7ff9b;
  border-bottom-color: #d7ff9b;
}

QDialog#playerNameDialog QLineEdit#playerNameEdit:disabled,
QWidget#settingsRoot QLineEdit:disabled,
QWidget#othelloSettingsRoot QLineEdit:disabled,
QWidget#settingsDialog QLineEdit:disabled,
QWidget#inventoryRoot QLineEdit:disabled,
QWidget#settingsRoot QComboBox:disabled,
QWidget#othelloSettingsRoot QComboBox:disabled,
QWidget#settingsDialog QComboBox:disabled,
QWidget#settingsRoot QSpinBox:disabled,
QWidget#settingsRoot QDoubleSpinBox:disabled,
QWidget#othelloSettingsRoot QSpinBox:disabled,
QWidget#othelloSettingsRoot QDoubleSpinBox:disabled,
QWidget#settingsDialog QSpinBox:disabled,
QWidget#settingsDialog QDoubleSpinBox:disabled {
  color: rgba(255,255,255,115);
  background: #171717;
  border-top-color: #080808;
  border-left-color: #080808;
  border-right-color: #333333;
  border-bottom-color: #333333;
}

QWidget#settingsRoot QComboBox::drop-down,
QWidget#othelloSettingsRoot QComboBox::drop-down,
QWidget#settingsDialog QComboBox::drop-down {
  width: 26px;
  background: #4f4f4f;
  border-left: 2px solid #080808;
}

QWidget#settingsRoot QComboBox::down-arrow,
QWidget#othelloSettingsRoot QComboBox::down-arrow,
QWidget#settingsDialog QComboBox::down-arrow {
  image: url("__ARROW_DOWN__");
  width: 10px;
  height: 6px;
}

QWidget#settingsRoot QComboBox QAbstractItemView,
QWidget#othelloSettingsRoot QComboBox QAbstractItemView,
QWidget#settingsDialog QComboBox QAbstractItemView {
  color: #ffffff;
  background: #202020;
  border-top: 2px solid #5c5c5c;
  border-left: 2px solid #5c5c5c;
  border-right: 2px solid #080808;
  border-bottom: 2px solid #080808;
  outline: none;
  selection-background-color: #4c7f2a;
  selection-color: #ffffff;
}

QWidget#settingsRoot QSpinBox::up-button,
QWidget#settingsRoot QSpinBox::down-button,
QWidget#settingsRoot QDoubleSpinBox::up-button,
QWidget#settingsRoot QDoubleSpinBox::down-button,
QWidget#othelloSettingsRoot QSpinBox::up-button,
QWidget#othelloSettingsRoot QSpinBox::down-button,
QWidget#othelloSettingsRoot QDoubleSpinBox::up-button,
QWidget#othelloSettingsRoot QDoubleSpinBox::down-button,
QWidget#settingsDialog QSpinBox::up-button,
QWidget#settingsDialog QSpinBox::down-button,
QWidget#settingsDialog QDoubleSpinBox::up-button,
QWidget#settingsDialog QDoubleSpinBox::down-button {
  width: 22px;
  background: #4f4f4f;
  border-left: 2px solid #080808;
}

QWidget#settingsRoot QSpinBox::up-arrow,
QWidget#settingsRoot QDoubleSpinBox::up-arrow,
QWidget#othelloSettingsRoot QSpinBox::up-arrow,
QWidget#othelloSettingsRoot QDoubleSpinBox::up-arrow,
QWidget#settingsDialog QSpinBox::up-arrow,
QWidget#settingsDialog QDoubleSpinBox::up-arrow {
  image: url("__ARROW_UP__");
  width: 10px;
  height: 6px;
}

QWidget#settingsRoot QSpinBox::down-arrow,
QWidget#settingsRoot QDoubleSpinBox::down-arrow,
QWidget#othelloSettingsRoot QSpinBox::down-arrow,
QWidget#othelloSettingsRoot QDoubleSpinBox::down-arrow,
QWidget#settingsDialog QSpinBox::down-arrow,
QWidget#settingsDialog QDoubleSpinBox::down-arrow {
  image: url("__ARROW_DOWN__");
  width: 10px;
  height: 6px;
}

/* Checkboxes */

QWidget#settingsRoot QCheckBox,
QWidget#othelloSettingsRoot QCheckBox,
QWidget#settingsDialog QCheckBox {
  color: #ffffff;
  spacing: 8px;
  margin-right: 18px;
  padding-right: 10px;
  min-height: 22px;
  font-weight: 800;
}

QWidget#settingsRoot QCheckBox:disabled,
QWidget#othelloSettingsRoot QCheckBox:disabled,
QWidget#settingsDialog QCheckBox:disabled {
  color: rgba(255,255,255,115);
}

QWidget#settingsRoot QCheckBox::indicator,
QWidget#othelloSettingsRoot QCheckBox::indicator,
QWidget#settingsDialog QCheckBox::indicator {
  width: 18px;
  height: 18px;
  background: #111111;
  border-top: 2px solid #050505;
  border-left: 2px solid #050505;
  border-right: 2px solid #5c5c5c;
  border-bottom: 2px solid #5c5c5c;
}

QWidget#settingsRoot QCheckBox::indicator:hover,
QWidget#othelloSettingsRoot QCheckBox::indicator:hover,
QWidget#settingsDialog QCheckBox::indicator:hover {
  background: #1a1a1a;
  border-right-color: #7a7a7a;
  border-bottom-color: #7a7a7a;
}

QWidget#settingsRoot QCheckBox::indicator:checked,
QWidget#othelloSettingsRoot QCheckBox::indicator:checked,
QWidget#settingsDialog QCheckBox::indicator:checked {
  background: #4c7f2a;
  border-top-color: #83bc54;
  border-left-color: #83bc54;
  border-right-color: #1d3510;
  border-bottom-color: #1d3510;
}

QWidget#settingsRoot QCheckBox::indicator:disabled,
QWidget#othelloSettingsRoot QCheckBox::indicator:disabled,
QWidget#settingsDialog QCheckBox::indicator:disabled {
  background: #171717;
  border-top-color: #080808;
  border-left-color: #080808;
  border-right-color: #333333;
  border-bottom-color: #333333;
}

/* Sliders */

QWidget#settingsRoot QSlider::groove:horizontal,
QWidget#othelloSettingsRoot QSlider::groove:horizontal,
QWidget#settingsDialog QSlider::groove:horizontal {
  height: 8px;
  background: #111111;
  border-top: 2px solid #050505;
  border-left: 2px solid #050505;
  border-right: 2px solid #5c5c5c;
  border-bottom: 2px solid #5c5c5c;
}

QWidget#settingsRoot QSlider::sub-page:horizontal,
QWidget#othelloSettingsRoot QSlider::sub-page:horizontal,
QWidget#settingsDialog QSlider::sub-page:horizontal {
  background: #4c7f2a;
  border-top: 1px solid #83bc54;
  border-left: 1px solid #83bc54;
  border-right: 1px solid #1d3510;
  border-bottom: 1px solid #1d3510;
}

QWidget#settingsRoot QSlider::add-page:horizontal,
QWidget#othelloSettingsRoot QSlider::add-page:horizontal,
QWidget#settingsDialog QSlider::add-page:horizontal {
  background: #111111;
  border: none;
}

QWidget#settingsRoot QSlider::handle:horizontal,
QWidget#othelloSettingsRoot QSlider::handle:horizontal,
QWidget#settingsDialog QSlider::handle:horizontal {
  background: #c8c8c8;
  border-top: 3px solid #ffffff;
  border-left: 3px solid #ffffff;
  border-right: 3px solid #4a4a4a;
  border-bottom: 3px solid #4a4a4a;
  width: 16px;
  height: 16px;
  margin: -6px 0px;
}

QWidget#settingsRoot QSlider::handle:horizontal:hover,
QWidget#othelloSettingsRoot QSlider::handle:horizontal:hover,
QWidget#settingsDialog QSlider::handle:horizontal:hover {
  background: #e0e0e0;
}

QWidget#settingsRoot QSlider::handle:horizontal:disabled,
QWidget#othelloSettingsRoot QSlider::handle:horizontal:disabled,
QWidget#settingsDialog QSlider::handle:horizontal:disabled {
  background: #646464;
  border-top-color: #858585;
  border-left-color: #858585;
  border-right-color: #2c2c2c;
  border-bottom-color: #2c2c2c;
}

/* Scrollbars */

QWidget#settingsRoot QScrollBar:vertical,
QWidget#othelloSettingsRoot QScrollBar:vertical,
QWidget#settingsDialog QScrollBar:vertical,
QWidget#inventoryRoot QScrollBar:vertical {
  width: 14px;
  background: #111111;
  border-left: 2px solid #080808;
  margin: 0px;
}

QWidget#settingsRoot QScrollBar::handle:vertical,
QWidget#othelloSettingsRoot QScrollBar::handle:vertical,
QWidget#settingsDialog QScrollBar::handle:vertical,
QWidget#inventoryRoot QScrollBar::handle:vertical {
  min-height: 30px;
  background: #5a5a5a;
  border-top: 2px solid #8a8a8a;
  border-left: 2px solid #8a8a8a;
  border-right: 2px solid #202020;
  border-bottom: 2px solid #202020;
}

QWidget#settingsRoot QScrollBar::handle:vertical:hover,
QWidget#othelloSettingsRoot QScrollBar::handle:vertical:hover,
QWidget#settingsDialog QScrollBar::handle:vertical:hover,
QWidget#inventoryRoot QScrollBar::handle:vertical:hover {
  background: #6a6a6a;
}

QWidget#settingsRoot QScrollBar::handle:vertical:pressed,
QWidget#othelloSettingsRoot QScrollBar::handle:vertical:pressed,
QWidget#settingsDialog QScrollBar::handle:vertical:pressed,
QWidget#inventoryRoot QScrollBar::handle:vertical:pressed {
  background: #505050;
  border-top-color: #777777;
  border-left-color: #777777;
  border-right-color: #1c1c1c;
  border-bottom-color: #1c1c1c;
}

QWidget#settingsRoot QScrollBar::add-line:vertical,
QWidget#settingsRoot QScrollBar::sub-line:vertical,
QWidget#othelloSettingsRoot QScrollBar::add-line:vertical,
QWidget#othelloSettingsRoot QScrollBar::sub-line:vertical,
QWidget#settingsDialog QScrollBar::add-line:vertical,
QWidget#settingsDialog QScrollBar::sub-line:vertical,
QWidget#inventoryRoot QScrollBar::add-line:vertical,
QWidget#inventoryRoot QScrollBar::sub-line:vertical {
  height: 0px;
  background: transparent;
  border: none;
}

QWidget#settingsRoot QScrollBar::add-page:vertical,
QWidget#settingsRoot QScrollBar::sub-page:vertical,
QWidget#othelloSettingsRoot QScrollBar::add-page:vertical,
QWidget#othelloSettingsRoot QScrollBar::sub-page:vertical,
QWidget#settingsDialog QScrollBar::add-page:vertical,
QWidget#settingsDialog QScrollBar::sub-page:vertical,
QWidget#inventoryRoot QScrollBar::add-page:vertical,
QWidget#inventoryRoot QScrollBar::sub-page:vertical {
  background: transparent;
}

/* Crosshair widgets */

QWidget#settingsRoot QWidget#crosshairPreview,
QWidget#settingsRoot QWidget#crosshairEditor,
QWidget#settingsDialog QWidget#crosshairPreview,
QWidget#settingsDialog QWidget#crosshairEditor {
  background: #111111;
  border-top: 2px solid #050505;
  border-left: 2px solid #050505;
  border-right: 2px solid #5c5c5c;
  border-bottom: 2px solid #5c5c5c;
  border-radius: 0px;
}

/* About page */

QWidget#settingsRoot QStackedWidget#aboutPageStack,
QWidget#settingsRoot QWidget#aboutLoaderPage {
  background: #242424;
  border: none;
}

QWidget#settingsRoot QFrame#aboutLoaderCard {
  background: #303030;
  border-top: 3px solid #5b5b5b;
  border-left: 3px solid #5b5b5b;
  border-right: 3px solid #111111;
  border-bottom: 3px solid #111111;
  border-radius: 0px;
}

QWidget#settingsRoot QProgressBar#aboutLoaderProgress {
  color: #ffffff;
  background: #111111;
  border-top: 2px solid #050505;
  border-left: 2px solid #050505;
  border-right: 2px solid #5b5b5b;
  border-bottom: 2px solid #5b5b5b;
  border-radius: 0px;
  text-align: center;
  font-size: 12px;
  font-weight: 800;
  min-height: 22px;
}

QWidget#settingsRoot QProgressBar#aboutLoaderProgress::chunk {
  background: #8bc45a;
  border-top: 1px solid #b8e884;
  border-left: 1px solid #b8e884;
  border-right: 1px solid #2b4519;
  border-bottom: 1px solid #2b4519;
}

QWidget#settingsRoot QProgressBar#aboutLoaderProgress:disabled {
  color: rgba(255,255,255,115);
  background: #171717;
  border-top-color: #080808;
  border-left-color: #080808;
  border-right-color: #333333;
  border-bottom-color: #333333;
}

QWidget#settingsRoot QFrame#aboutProfileCover,
QWidget#othelloSettingsRoot QFrame#aboutProfileCover,
QWidget#settingsDialog QFrame#aboutProfileCover {
  background: #203818;
  border-top: none;
  border-left: none;
  border-right: none;
  border-bottom: 4px solid #0b0b0b;
  min-height: 140px;
  max-height: 140px;
}

QWidget#settingsRoot QWidget#aboutAvatarLayer,
QWidget#othelloSettingsRoot QWidget#aboutAvatarLayer,
QWidget#settingsDialog QWidget#aboutAvatarLayer {
  background: transparent;
  border: none;
}

QWidget#settingsRoot QLabel#aboutProfileMark,
QWidget#othelloSettingsRoot QLabel#aboutProfileMark,
QWidget#settingsDialog QLabel#aboutProfileMark {
  color: rgba(255,255,255,235);
  font-size: 32px;
  font-weight: 800;
}

QWidget#settingsRoot QLabel#aboutAvatar,
QWidget#othelloSettingsRoot QLabel#aboutAvatar,
QWidget#settingsDialog QLabel#aboutAvatar {
  color: #ffffff;
  background: #2a2a2a;
  border-top: 4px solid #777777;
  border-left: 4px solid #777777;
  border-right: 4px solid #080808;
  border-bottom: 4px solid #080808;
  border-radius: 0px;
  padding: 0px;
  font-size: 32px;
  font-weight: 800;
}

QWidget#settingsRoot QLabel#aboutProfileName,
QWidget#othelloSettingsRoot QLabel#aboutProfileName,
QWidget#settingsDialog QLabel#aboutProfileName {
  color: #ffffff;
  font-size: 24px;
  font-weight: 800;
}

QWidget#settingsRoot QLabel#aboutProfileHandle,
QWidget#othelloSettingsRoot QLabel#aboutProfileHandle,
QWidget#settingsDialog QLabel#aboutProfileHandle,
QWidget#settingsRoot QLabel#aboutProfileBio,
QWidget#othelloSettingsRoot QLabel#aboutProfileBio,
QWidget#settingsDialog QLabel#aboutProfileBio,
QWidget#settingsRoot QLabel#aboutProfileRole,
QWidget#othelloSettingsRoot QLabel#aboutProfileRole,
QWidget#settingsDialog QLabel#aboutProfileRole,
QWidget#settingsRoot QLabel#aboutMetaValue,
QWidget#othelloSettingsRoot QLabel#aboutMetaValue,
QWidget#settingsDialog QLabel#aboutMetaValue {
  color: rgba(255,255,255,205);
  font-size: 13px;
}

QWidget#settingsRoot QLabel#aboutProfileRole,
QWidget#othelloSettingsRoot QLabel#aboutProfileRole,
QWidget#settingsDialog QLabel#aboutProfileRole {
  color: #ffffff;
  font-weight: 800;
}

QWidget#settingsRoot QWidget#aboutTagFlow,
QWidget#othelloSettingsRoot QWidget#aboutTagFlow,
QWidget#settingsDialog QWidget#aboutTagFlow,
QWidget#settingsRoot QWidget#aboutInlineParagraph,
QWidget#othelloSettingsRoot QWidget#aboutInlineParagraph,
QWidget#settingsDialog QWidget#aboutInlineParagraph {
  background: transparent;
  border: none;
}

QWidget#settingsRoot QLabel#aboutPill,
QWidget#othelloSettingsRoot QLabel#aboutPill,
QWidget#settingsDialog QLabel#aboutPill {
  color: #ffffff;
  background: #4c7f2a;
  border-top: 2px solid #83bc54;
  border-left: 2px solid #83bc54;
  border-right: 2px solid #1d3510;
  border-bottom: 2px solid #1d3510;
  border-radius: 0px;
  padding: 4px 10px;
  font-size: 12px;
  font-weight: 800;
}

QWidget#settingsRoot QLabel#aboutMetaTitle,
QWidget#othelloSettingsRoot QLabel#aboutMetaTitle,
QWidget#settingsDialog QLabel#aboutMetaTitle {
  color: rgba(255,255,255,170);
  font-size: 12px;
  font-weight: 800;
  min-width: 142px;
  qproperty-alignment: 'AlignRight | AlignVCenter';
}

QWidget#settingsRoot QLabel#aboutSectionTitle,
QWidget#othelloSettingsRoot QLabel#aboutSectionTitle,
QWidget#settingsDialog QLabel#aboutSectionTitle {
  color: #ffffff;
  font-size: 14px;
  font-weight: 800;
  padding-top: 8px;
}

QWidget#settingsRoot QLabel#aboutCodeBlock,
QWidget#othelloSettingsRoot QLabel#aboutCodeBlock,
QWidget#settingsDialog QLabel#aboutCodeBlock {
  color: #f5f5f5;
  background: #111111;
  border-top: 2px solid #050505;
  border-left: 2px solid #050505;
  border-right: 2px solid #5c5c5c;
  border-bottom: 2px solid #5c5c5c;
  border-radius: 0px;
  padding: 8px 10px;
  font-size: 12px;
}

QWidget#settingsRoot QLabel#aboutInlineCode,
QWidget#othelloSettingsRoot QLabel#aboutInlineCode,
QWidget#settingsDialog QLabel#aboutInlineCode {
  color: #f5f5f5;
  background: #111111;
  border-top: 1px solid #050505;
  border-left: 1px solid #050505;
  border-right: 1px solid #5c5c5c;
  border-bottom: 1px solid #5c5c5c;
  border-radius: 0px;
  padding: 1px 4px;
  font-size: 12px;
}

QWidget#settingsRoot QPushButton#aboutGithubButton,
QWidget#othelloSettingsRoot QPushButton#aboutGithubButton,
QWidget#settingsDialog QPushButton#aboutGithubButton,
QWidget#settingsRoot QPushButton#linkBtn,
QWidget#othelloSettingsRoot QPushButton#linkBtn,
QWidget#settingsDialog QPushButton#linkBtn {
  color: #ffffff;
  background: #5c5c5c;
  border-top: 3px solid #8f8f8f;
  border-left: 3px solid #8f8f8f;
  border-right: 3px solid #202020;
  border-bottom: 3px solid #202020;
  border-radius: 0px;
  padding: 7px 14px;
  min-height: 24px;
  font-size: 13px;
  font-weight: 800;
  text-align: left;
}

QWidget#settingsRoot QPushButton#aboutGithubButton:hover,
QWidget#othelloSettingsRoot QPushButton#aboutGithubButton:hover,
QWidget#settingsDialog QPushButton#aboutGithubButton:hover,
QWidget#settingsRoot QPushButton#linkBtn:hover,
QWidget#settingsDialog QPushButton#linkBtn:hover {
  background: #6d6d6d;
}

QWidget#settingsRoot QPushButton#aboutGithubButton:pressed,
QWidget#othelloSettingsRoot QPushButton#aboutGithubButton:pressed,
QWidget#settingsDialog QPushButton#aboutGithubButton:pressed,
QWidget#settingsRoot QPushButton#linkBtn:pressed,
QWidget#settingsDialog QPushButton#linkBtn:pressed {
  background: #484848;
  border-top-color: #202020;
  border-left-color: #202020;
  border-right-color: #8f8f8f;
  border-bottom-color: #8f8f8f;
}

/* Othello adjuncts */

QWidget#othelloGraph {
  background: #111111;
  border-top: 2px solid #050505;
  border-left: 2px solid #050505;
  border-right: 2px solid #5c5c5c;
  border-bottom: 2px solid #5c5c5c;
  border-radius: 0px;
}

QWidget#othelloSettingsRoot QLabel#othelloBookStatus,
QWidget#settingsDialog QLabel#othelloBookStatus {
  color: rgba(255,255,255,205);
  font-size: 12px;
}

/* Inventory and hotbar */

QWidget#inventoryRoot QPushButton#slot,
QWidget#hotbarRoot QPushButton#slot {
  background: rgba(20,20,20,240);
  border-top: 2px solid #555555;
  border-left: 2px solid #555555;
  border-right: 2px solid #080808;
  border-bottom: 2px solid #080808;
  border-radius: 0px;
  padding: 0px;
}

QWidget#inventoryRoot QPushButton#slot:hover,
QWidget#hotbarRoot QPushButton#slot:hover {
  background: rgba(32,32,32,245);
  border-top-color: #777777;
  border-left-color: #777777;
}

QWidget#inventoryRoot QPushButton#slot[selected="true"],
QWidget#hotbarRoot QPushButton#slot[selected="true"] {
  background: rgba(45,72,30,245);
  border-top: 3px solid #b8e884;
  border-left: 3px solid #b8e884;
  border-right: 3px solid #1c2d12;
  border-bottom: 3px solid #1c2d12;
}

QWidget#hotbarRoot QFrame#hotbarPanel {
  background: transparent;
  border: none;
}

/* Notice dialog */

QWidget#noticeDialog {
  background: rgba(0,0,0,0);
}

QWidget#noticeDialog QFrame#noticePanel {
  background: rgba(30,30,30,240);
  border-top: 3px solid #5f5f5f;
  border-left: 3px solid #5f5f5f;
  border-right: 3px solid #080808;
  border-bottom: 3px solid #080808;
  border-radius: 0px;
}
