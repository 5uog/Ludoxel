/* Ludoxel main theme: block-based Minecraft-style stone UI. */

QMainWindow {
  background: #101010;
}

QToolTip {
  color: #ffffff;
  background: #1e1e1e;
  border-top: 2px solid #5f5f5f;
  border-left: 2px solid #5f5f5f;
  border-right: 2px solid #0a0a0a;
  border-bottom: 2px solid #0a0a0a;
  padding: 6px 8px;
}

/* Gameplay HUD */

QLabel#hud,
QLabel#playerNameTag,
QLabel#othelloHud {
  color: rgba(255,255,255,240);
  background: rgba(18,18,18,170);
  border: 2px solid rgba(0,0,0,210);
  padding: 8px 10px;
}

QLabel#playerNameTag {
  border: none;
}

QLabel#othelloTitle {
  color: #ffffff;
  background: rgba(22,22,22,205);
  border-top: 3px solid #5a5a5a;
  border-left: 3px solid #5a5a5a;
  border-right: 3px solid #080808;
  border-bottom: 3px solid #080808;
  padding: 10px 18px;
  font-size: 24px;
  font-weight: 800;
}

QWidget#pauseRoot,
QWidget#inventoryRoot,
QWidget#deathRoot {
  background: rgba(0,0,0,150);
}

QWidget#settingsRoot[detachedWindow="false"],
QWidget#othelloSettingsRoot[detachedWindow="false"],
QWidget#settingsDialog[detachedWindow="false"] {
  background: rgba(0,0,0,150);
}

QWidget#settingsRoot[detachedWindow="true"],
QWidget#othelloSettingsRoot[detachedWindow="true"],
QWidget#settingsDialog[detachedWindow="true"] {
  background: #151515;
}

/* Main stone panels */

QWidget#pauseRoot QFrame#panel,
QWidget#inventoryRoot QFrame#panel,
QWidget#deathRoot QFrame#panel,
QDialog#playerNameDialog QFrame#playerNamePanel {
  background: #2a2a2a;
  border-top: 4px solid #666666;
  border-left: 4px solid #666666;
  border-right: 4px solid #0b0b0b;
  border-bottom: 4px solid #0b0b0b;
  border-radius: 0px;
}

QWidget#settingsRoot QFrame#panel,
QWidget#othelloSettingsRoot QFrame#panel,
QWidget#settingsDialog QFrame#panel {
  background: #242424;
  border: none;
  border-radius: 0px;
}

QWidget#settingsRoot QWidget#settingsSidebar,
QWidget#othelloSettingsRoot QWidget#othelloSettingsSidebar,
QWidget#settingsDialog QWidget#settingsSidebar {
  background: #1a1a1a;
  border-top: none;
  border-left: none;
  border-right: 4px solid #080808;
  border-bottom: none;
}

QWidget#settingsRoot QLabel#settingsSidebarTitle,
QWidget#othelloSettingsRoot QLabel#settingsSidebarTitle,
QWidget#settingsDialog QLabel#settingsSidebarTitle {
  color: #ffffff;
  font-size: 18px;
  font-weight: 800;
  padding: 12px 16px 10px 16px;
}

QWidget#settingsRoot QWidget#settingsContent,
QWidget#othelloSettingsRoot QWidget#othelloSettingsContent,
QWidget#settingsDialog QWidget#settingsContent,
QWidget#settingsRoot QStackedWidget#settingsStack,
QWidget#othelloSettingsRoot QStackedWidget#othelloSettingsStack,
QWidget#settingsDialog QStackedWidget#settingsStack {
  background: #242424;
  border: none;
}

QWidget#settingsRoot QWidget#settingsViewport,
QWidget#othelloSettingsRoot QWidget#settingsViewport,
QWidget#settingsDialog QWidget#settingsViewport,
QWidget#settingsRoot QWidget#settingsPage,
QWidget#othelloSettingsRoot QWidget#settingsPage,
QWidget#settingsDialog QWidget#settingsPage,
QWidget#settingsRoot QWidget#aboutPage,
QWidget#othelloSettingsRoot QWidget#aboutPage,
QWidget#settingsDialog QWidget#aboutPage {
  background: #242424;
}

QWidget#settingsRoot QScrollArea,
QWidget#othelloSettingsRoot QScrollArea,
QWidget#settingsDialog QScrollArea,
QWidget#inventoryRoot QScrollArea {
  background: transparent;
  border: none;
}

/* Text */

QWidget#pauseRoot QLabel,
QWidget#settingsRoot QLabel,
QWidget#othelloSettingsRoot QLabel,
QWidget#settingsDialog QLabel,
QWidget#inventoryRoot QLabel,
QWidget#deathRoot QLabel,
QDialog#playerNameDialog QLabel,
QWidget#noticeDialog QLabel {
  color: #ffffff;
  font-size: 13px;
}

QWidget#pauseRoot QLabel#title,
QWidget#inventoryRoot QLabel#title,
QWidget#deathRoot QLabel#title,
QDialog#playerNameDialog QLabel#playerNameTitle {
  color: #ffffff;
  font-size: 24px;
  font-weight: 800;
}

QWidget#deathRoot QLabel#title {
  color: #ff7777;
}

QWidget#settingsRoot QLabel#settingsPageTitle,
QWidget#othelloSettingsRoot QLabel#settingsPageTitle,
QWidget#settingsDialog QLabel#settingsPageTitle {
  color: #ffffff;
  font-size: 24px;
  font-weight: 800;
  padding: 0px 0px 2px 0px;
}

QWidget#pauseRoot QLabel#subtitle,
QWidget#settingsRoot QLabel#subtitle,
QWidget#othelloSettingsRoot QLabel#subtitle,
QWidget#settingsDialog QLabel#subtitle,
QWidget#inventoryRoot QLabel#subtitle,
QWidget#deathRoot QLabel#subtitle,
QDialog#playerNameDialog QLabel#playerNameSubtitle,
QWidget#settingsRoot QLabel#settingsPageSubtitle,
QWidget#othelloSettingsRoot QLabel#settingsPageSubtitle,
QWidget#settingsDialog QLabel#settingsPageSubtitle {
  color: rgba(255,255,255,205);
  font-size: 13px;
}

QWidget#pauseRoot QLabel#sectionTitle,
QWidget#settingsRoot QLabel#sectionTitle,
QWidget#othelloSettingsRoot QLabel#sectionTitle,
QWidget#settingsDialog QLabel#sectionTitle,
QWidget#settingsRoot QLabel#settingsCardTitle,
QWidget#othelloSettingsRoot QLabel#settingsCardTitle,
QWidget#settingsDialog QLabel#settingsCardTitle,
QWidget#noticeDialog QLabel#noticeTitle {
  color: #f5f5f5;
  font-size: 15px;
  font-weight: 800;
}

QWidget#settingsRoot QLabel#settingsCardDescription,
QWidget#othelloSettingsRoot QLabel#settingsCardDescription,
QWidget#settingsDialog QLabel#settingsCardDescription,
QWidget#settingsRoot QLabel#settingsRowDescription,
QWidget#othelloSettingsRoot QLabel#settingsRowDescription,
QWidget#settingsDialog QLabel#settingsRowDescription,
QWidget#noticeDialog QLabel#noticeMessage {
  color: rgba(255,255,255,195);
  font-size: 12px;
}

QWidget#settingsRoot QLabel#valueLabel,
QWidget#othelloSettingsRoot QLabel#valueLabel,
QWidget#settingsDialog QLabel#valueLabel,
QWidget#settingsRoot QLabel#settingsRowLabel,
QWidget#othelloSettingsRoot QLabel#settingsRowLabel,
QWidget#settingsDialog QLabel#settingsRowLabel,
QWidget#settingsRoot QLabel#bedrockToggleLabel,
QWidget#othelloSettingsRoot QLabel#bedrockToggleLabel,
QWidget#settingsDialog QLabel#bedrockToggleLabel {
  color: #ffffff;
  font-size: 13px;
  font-weight: 800;
}

QFrame#sep {
  color: #0b0b0b;
  background: #0b0b0b;
  min-height: 3px;
  max-height: 3px;
  border: none;
}

/* Settings cards and rows */

QWidget#settingsRoot QFrame#settingsCard,
QWidget#othelloSettingsRoot QFrame#settingsCard,
QWidget#settingsDialog QFrame#settingsCard,
QWidget#settingsRoot QWidget#settingsCard,
QWidget#othelloSettingsRoot QWidget#settingsCard,
QWidget#settingsDialog QWidget#settingsCard,
QWidget#settingsRoot QFrame#aboutCard,
QWidget#othelloSettingsRoot QFrame#aboutCard,
QWidget#settingsDialog QFrame#aboutCard,
QWidget#settingsRoot QFrame#aboutProfileCard,
QWidget#othelloSettingsRoot QFrame#aboutProfileCard,
QWidget#settingsDialog QFrame#aboutProfileCard {
  background: #303030;
  border-top: 3px solid #5b5b5b;
  border-left: 3px solid #5b5b5b;
  border-right: 3px solid #111111;
  border-bottom: 3px solid #111111;
  border-radius: 0px;
}

QWidget#settingsRoot QWidget#settingsCardBody,
QWidget#othelloSettingsRoot QWidget#settingsCardBody,
QWidget#settingsDialog QWidget#settingsCardBody,
QWidget#settingsRoot QWidget#settingsRowText,
QWidget#othelloSettingsRoot QWidget#settingsRowText,
QWidget#settingsDialog QWidget#settingsRowText,
QWidget#settingsRoot QWidget#settingsRowControl,
QWidget#othelloSettingsRoot QWidget#settingsRowControl,
QWidget#settingsDialog QWidget#settingsRowControl,
QWidget#settingsRoot QWidget#settingsPageHeader,
QWidget#othelloSettingsRoot QWidget#settingsPageHeader,
QWidget#settingsDialog QWidget#settingsPageHeader {
  background: transparent;
  border: none;
}

QWidget#settingsRoot QWidget#settingsRow,
QWidget#othelloSettingsRoot QWidget#settingsRow,
QWidget#settingsDialog QWidget#settingsRow,
QWidget#settingsRoot QWidget#bedrockToggleRow,
QWidget#othelloSettingsRoot QWidget#bedrockToggleRow,
QWidget#settingsDialog QWidget#bedrockToggleRow {
  background: #262626;
  border-top: 2px solid #4a4a4a;
  border-left: 2px solid #4a4a4a;
  border-right: 2px solid #101010;
  border-bottom: 2px solid #101010;
  border-radius: 0px;
  min-height: 42px;
}

QWidget#settingsRoot QWidget#settingsRow:hover,
QWidget#othelloSettingsRoot QWidget#settingsRow:hover,
QWidget#settingsDialog QWidget#settingsRow:hover,
QWidget#settingsRoot QWidget#bedrockToggleRow:hover,
QWidget#othelloSettingsRoot QWidget#bedrockToggleRow:hover,
QWidget#settingsDialog QWidget#bedrockToggleRow:hover {
  background: #2d2d2d;
  border-top-color: #606060;
  border-left-color: #606060;
}

/* Navigation */

QWidget#settingsRoot QPushButton#navBtn,
QWidget#othelloSettingsRoot QPushButton#navBtn,
QWidget#settingsDialog QPushButton#navBtn {
  color: rgba(255,255,255,215);
  background: #242424;
  border-top: 2px solid transparent;
  border-left: 4px solid transparent;
  border-right: 0px solid transparent;
  border-bottom: 2px solid transparent;
  border-radius: 0px;
  margin-right: 4px;
  padding: 12px 16px;
  min-height: 32px;
  font-size: 15px;
  font-weight: 800;
  text-align: left;
}

QWidget#settingsRoot QPushButton#navBtn:hover,
QWidget#othelloSettingsRoot QPushButton#navBtn:hover,
QWidget#settingsDialog QPushButton#navBtn:hover {
  color: #ffffff;
  background: #343434;
  border-left-color: #6a6a6a;
}

QWidget#settingsRoot QPushButton#navBtn:checked,
QWidget#othelloSettingsRoot QPushButton#navBtn:checked,
QWidget#settingsDialog QPushButton#navBtn:checked {
  color: #ffffff;
  background: #3f5f2b;
  border-top-color: #6d9c45;
  border-left-color: #8bc45a;
  border-right-color: transparent;
  border-bottom-color: #1b2a13;
}

QWidget#settingsRoot QPushButton#navBtn:focus,
QWidget#othelloSettingsRoot QPushButton#navBtn:focus,
QWidget#settingsDialog QPushButton#navBtn:focus {
  color: #ffffff;
  border-left-color: #d7ff9b;
}

QWidget#settingsRoot QPushButton#navBtn:disabled,
QWidget#othelloSettingsRoot QPushButton#navBtn:disabled,
QWidget#settingsDialog QPushButton#navBtn:disabled {
  color: rgba(255,255,255,90);
  background: #1b1b1b;
}

/* Buttons */

QWidget#pauseRoot QPushButton#menuBtn,
QWidget#inventoryRoot QPushButton#closeBtn,
QWidget#deathRoot QPushButton,
QWidget#settingsRoot QPushButton#menuBtn,
QWidget#othelloSettingsRoot QPushButton#menuBtn,
QWidget#settingsDialog QPushButton#menuBtn,
QWidget#settingsRoot QPushButton#secondaryBtn,
QWidget#othelloSettingsRoot QPushButton#secondaryBtn,
QWidget#settingsDialog QPushButton#secondaryBtn,
QWidget#settingsRoot QPushButton#othelloBookButton,
QWidget#othelloSettingsRoot QPushButton#othelloBookButton,
QWidget#settingsDialog QPushButton#othelloBookButton,
QDialog#playerNameDialog QPushButton#playerNameContinue {
  color: #ffffff;
  background: #6b6b6b;
  border-top: 3px solid #a0a0a0;
  border-left: 3px solid #a0a0a0;
  border-right: 3px solid #252525;
  border-bottom: 3px solid #252525;
  border-radius: 0px;
  padding: 7px 14px;
  min-height: 24px;
  font-weight: 800;
}

QWidget#pauseRoot QPushButton#menuBtn:hover,
QWidget#inventoryRoot QPushButton#closeBtn:hover,
QWidget#deathRoot QPushButton:hover,
QWidget#settingsRoot QPushButton#menuBtn:hover,
QWidget#othelloSettingsRoot QPushButton#menuBtn:hover,
QWidget#settingsDialog QPushButton#menuBtn:hover,
QWidget#settingsRoot QPushButton#secondaryBtn:hover,
QWidget#othelloSettingsRoot QPushButton#secondaryBtn:hover,
QWidget#settingsDialog QPushButton#secondaryBtn:hover,
QWidget#settingsRoot QPushButton#othelloBookButton:hover,
QWidget#othelloSettingsRoot QPushButton#othelloBookButton:hover,
QWidget#settingsDialog QPushButton#othelloBookButton:hover,
QDialog#playerNameDialog QPushButton#playerNameContinue:hover {
  background: #7a7a7a;
  border-top-color: #b4b4b4;
  border-left-color: #b4b4b4;
}

QWidget#pauseRoot QPushButton#menuBtn:pressed,
QWidget#inventoryRoot QPushButton#closeBtn:pressed,
QWidget#deathRoot QPushButton:pressed,
QWidget#settingsRoot QPushButton#menuBtn:pressed,
QWidget#othelloSettingsRoot QPushButton#menuBtn:pressed,
QWidget#settingsDialog QPushButton#menuBtn:pressed,
QWidget#settingsRoot QPushButton#secondaryBtn:pressed,
QWidget#othelloSettingsRoot QPushButton#secondaryBtn:pressed,
QWidget#settingsDialog QPushButton#secondaryBtn:pressed,
QWidget#settingsRoot QPushButton#othelloBookButton:pressed,
QWidget#othelloSettingsRoot QPushButton#othelloBookButton:pressed,
QWidget#settingsDialog QPushButton#othelloBookButton:pressed,
QDialog#playerNameDialog QPushButton#playerNameContinue:pressed {
  background: #555555;
  border-top-color: #202020;
  border-left-color: #202020;
  border-right-color: #9a9a9a;
  border-bottom-color: #9a9a9a;
}

QWidget#pauseRoot QPushButton#menuBtn:focus,
QWidget#inventoryRoot QPushButton#closeBtn:focus,
QWidget#deathRoot QPushButton:focus,
QWidget#settingsRoot QPushButton#menuBtn:focus,
QWidget#othelloSettingsRoot QPushButton#menuBtn:focus,
QWidget#settingsDialog QPushButton#menuBtn:focus,
QWidget#settingsRoot QPushButton#secondaryBtn:focus,
QWidget#othelloSettingsRoot QPushButton#secondaryBtn:focus,
QWidget#settingsDialog QPushButton#secondaryBtn:focus,
QDialog#playerNameDialog QPushButton#playerNameContinue:focus {
  border-top-color: #d9d9d9;
  border-left-color: #d9d9d9;
  border-right-color: #0b0b0b;
  border-bottom-color: #0b0b0b;
}

QWidget#pauseRoot QPushButton#menuBtn:disabled,
QWidget#inventoryRoot QPushButton#closeBtn:disabled,
QWidget#deathRoot QPushButton:disabled,
QWidget#settingsRoot QPushButton#menuBtn:disabled,
QWidget#othelloSettingsRoot QPushButton#menuBtn:disabled,
QWidget#settingsDialog QPushButton#menuBtn:disabled,
QWidget#settingsRoot QPushButton#secondaryBtn:disabled,
QWidget#othelloSettingsRoot QPushButton#secondaryBtn:disabled,
QWidget#settingsDialog QPushButton#secondaryBtn:disabled,
QWidget#settingsRoot QPushButton#othelloBookButton:disabled,
QWidget#othelloSettingsRoot QPushButton#othelloBookButton:disabled,
QWidget#settingsDialog QPushButton#othelloBookButton:disabled,
QDialog#playerNameDialog QPushButton#playerNameContinue:disabled {
  color: rgba(255,255,255,115);
  background: #444444;
  border-top-color: #606060;
  border-left-color: #606060;
  border-right-color: #222222;
  border-bottom-color: #222222;
}

QWidget#settingsRoot QPushButton#primaryBtn,
QWidget#othelloSettingsRoot QPushButton#primaryBtn,
QWidget#settingsDialog QPushButton#primaryBtn {
  color: #ffffff;
  background: #4c7f2a;
  border-top: 3px solid #83bc54;
  border-left: 3px solid #83bc54;
  border-right: 3px solid #1d3510;
  border-bottom: 3px solid #1d3510;
  border-radius: 0px;
  padding: 7px 16px;
  min-height: 24px;
  min-width: 132px;
  font-weight: 800;
}

QWidget#settingsRoot QPushButton#primaryBtn:hover,
QWidget#othelloSettingsRoot QPushButton#primaryBtn:hover,
QWidget#settingsDialog QPushButton#primaryBtn:hover {
  background: #5d9434;
  border-top-color: #9fd56e;
  border-left-color: #9fd56e;
}

QWidget#settingsRoot QPushButton#primaryBtn:pressed,
QWidget#othelloSettingsRoot QPushButton#primaryBtn:pressed,
QWidget#settingsDialog QPushButton#primaryBtn:pressed {
  background: #3d6721;
  border-top-color: #1d3510;
  border-left-color: #1d3510;
  border-right-color: #83bc54;
  border-bottom-color: #83bc54;
}

QWidget#settingsRoot QPushButton#primaryBtn:disabled,
QWidget#othelloSettingsRoot QPushButton#primaryBtn:disabled,
QWidget#settingsDialog QPushButton#primaryBtn:disabled {
  color: rgba(255,255,255,118);
  background: #365029;
  border-top-color: #567345;
  border-left-color: #567345;
  border-right-color: #182612;
  border-bottom-color: #182612;
}

QWidget#settingsRoot QPushButton#dangerBtn,
QWidget#othelloSettingsRoot QPushButton#dangerBtn,
QWidget#settingsDialog QPushButton#dangerBtn {
  color: #ffffff;
  background: #8a3030;
  border-top: 3px solid #c85d5d;
  border-left: 3px solid #c85d5d;
  border-right: 3px solid #3c1111;
  border-bottom: 3px solid #3c1111;
  border-radius: 0px;
  padding: 7px 14px;
  min-height: 24px;
  font-weight: 800;
}

QWidget#settingsRoot QPushButton#dangerBtn:hover,
QWidget#othelloSettingsRoot QPushButton#dangerBtn:hover,
QWidget#settingsDialog QPushButton#dangerBtn:hover {
  background: #a43a3a;
  border-top-color: #e07878;
  border-left-color: #e07878;
}

QWidget#settingsRoot QPushButton#dangerBtn:pressed,
QWidget#othelloSettingsRoot QPushButton#dangerBtn:pressed,
QWidget#settingsDialog QPushButton#dangerBtn:pressed {
  background: #702424;
  border-top-color: #3c1111;
  border-left-color: #3c1111;
  border-right-color: #c85d5d;
  border-bottom-color: #c85d5d;
}

QWidget#settingsRoot QPushButton#dangerBtn:disabled,
QWidget#othelloSettingsRoot QPushButton#dangerBtn:disabled,
QWidget#settingsDialog QPushButton#dangerBtn:disabled {
  color: rgba(255,255,255,118);
  background: #563030;
  border-top-color: #744444;
  border-left-color: #744444;
  border-right-color: #281414;
  border-bottom-color: #281414;
}

QWidget#settingsRoot QPushButton#modeToggle,
QWidget#othelloSettingsRoot QPushButton#modeToggle,
QWidget#settingsDialog QPushButton#modeToggle {
  color: #ffffff;
  background: #555555;
  border-top: 3px solid #858585;
  border-left: 3px solid #858585;
  border-right: 3px solid #202020;
  border-bottom: 3px solid #202020;
  border-radius: 0px;
  padding: 7px 14px;
  min-height: 24px;
  font-weight: 800;
  text-align: left;
}

QWidget#settingsRoot QPushButton#modeToggle:hover,
QWidget#othelloSettingsRoot QPushButton#modeToggle:hover,
QWidget#settingsDialog QPushButton#modeToggle:hover {
  background: #666666;
}

QWidget#settingsRoot QPushButton#modeToggle:checked,
QWidget#othelloSettingsRoot QPushButton#modeToggle:checked,
QWidget#settingsDialog QPushButton#modeToggle:checked {
  background: #4c7f2a;
  border-top-color: #83bc54;
  border-left-color: #83bc54;
  border-right-color: #1d3510;
  border-bottom-color: #1d3510;
}

QWidget#settingsRoot QPushButton#modeToggle:pressed,
QWidget#othelloSettingsRoot QPushButton#modeToggle:pressed,
QWidget#settingsDialog QPushButton#modeToggle:pressed {
  background: #444444;
  border-top-color: #202020;
  border-left-color: #202020;
  border-right-color: #858585;
  border-bottom-color: #858585;
}

/* Form controls */

QDialog#playerNameDialog QLineEdit#playerNameEdit,
QWidget#settingsRoot QLineEdit,
QWidget#othelloSettingsRoot QLineEdit,
QWidget#settingsDialog QLineEdit,
QWidget#inventoryRoot QLineEdit,
QWidget#settingsRoot QComboBox,
QWidget#othelloSettingsRoot QComboBox,
QWidget#settingsDialog QComboBox,
QWidget#settingsRoot QSpinBox,
QWidget#settingsRoot QDoubleSpinBox,
QWidget#othelloSettingsRoot QSpinBox,
QWidget#othelloSettingsRoot QDoubleSpinBox,
QWidget#settingsDialog QSpinBox,
QWidget#settingsDialog QDoubleSpinBox {
  color: #ffffff;
  background: #111111;
  border-top: 3px solid #050505;
  border-left: 3px solid #050505;
  border-right: 3px solid #555555;
  border-bottom: 3px solid #555555;
  border-radius: 0px;
  padding: 7px 10px;
  min-height: 24px;
  selection-background-color: #5b8f35;
  selection-color: #ffffff;
}

QWidget#settingsRoot QComboBox,
QWidget#othelloSettingsRoot QComboBox,
QWidget#settingsDialog QComboBox,
QWidget#settingsRoot QSpinBox,
QWidget#settingsRoot QDoubleSpinBox,
QWidget#othelloSettingsRoot QSpinBox,
QWidget#othelloSettingsRoot QDoubleSpinBox,
QWidget#settingsDialog QSpinBox,
QWidget#settingsDialog QDoubleSpinBox {
  padding-right: 30px;
}

QDialog#playerNameDialog QLineEdit#playerNameEdit:hover,
QWidget#settingsRoot QLineEdit:hover,
QWidget#othelloSettingsRoot QLineEdit:hover,
QWidget#settingsDialog QLineEdit:hover,
QWidget#inventoryRoot QLineEdit:hover,
QWidget#settingsRoot QComboBox:hover,
QWidget#othelloSettingsRoot QComboBox:hover,
QWidget#settingsDialog QComboBox:hover,
QWidget#settingsRoot QSpinBox:hover,
