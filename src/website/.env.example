# Ludoxel documentation feedback storage.
# Copy this file to .env.local for local development.
# Do not commit .env.local or any file containing real tokens.

# Upstash Redis REST API HTTPS endpoint.
# Example value format:
# UPSTASH_REDIS_REST_URL=https://example-upstash-redis.upstash.io
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST API write token.
# Use the normal Token, not the Readonly Token, because feedback voting writes data.
UPSTASH_REDIS_REST_TOKEN=
