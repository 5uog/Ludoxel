{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "rewrites": [
    {
      "source": "/api/vote",
      "destination": "/backend/api/vote.ts"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
