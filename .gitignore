# Node dependency tree installed by npm.
node_modules/

# Build, package, test, and coverage outputs.
dist/
build/
coverage/
src/website/dist/
src/website/.vite/
src/website/node_modules/
src/website/.vercel/

# Local analysis, inventory, code-dump, and temporary pip target outputs.
.artifacts/

# Local Manim media output generated by website figure rendering.
media/

# Local website video artifacts replaced by YouTube embeds.
src/website/frontend/public/figures/videos/*.mp4
src/website/frontend/public/assets/videos/*.mp4

# Python bytecode, pytest/mypy/ruff caches, and local virtual environments.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv_ludoxel/

# Editable-install and package metadata generated locally by Python tooling.
*.egg-info/
.eggs/

# Native extension products generated by the local performance build.
src/**/*.pyd
src/**/*.so
src/**/*.dylib
src/**/*.dll

# Local cache used by the repository-managed Ruff wrapper.
tools/format_python_source/.cache/

# Directory-export outputs generated by tools/export_directory_markdown.
tools/export_directory_markdown/output/

# Operating-system and editor noise.
.DS_Store
Thumbs.db
*.swp
*.swo
