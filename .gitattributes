# Normalize text files to LF in the repository.
* text=auto eol=lf

# Keep Windows command files with CRLF when such files are added.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat common image, font, audio, model, native, and archive files as binary.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.bmp binary
*.ico binary
*.gif binary
*.ttf binary
*.otf binary
*.wav binary
*.ogg binary
*.mp3 binary
*.flac binary
*.glb binary
*.pyd binary
*.so binary
*.dylib binary
*.dll binary
*.exe binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.bin binary
*.pyc binary

# Website source files must stay LF text files.
src/website/**/*.ts text eol=lf
src/website/**/*.tsx text eol=lf
src/website/**/*.js text eol=lf
src/website/**/*.jsx text eol=lf
src/website/**/*.mjs text eol=lf
src/website/**/*.cjs text eol=lf
src/website/**/*.css text eol=lf
src/website/**/*.html text eol=lf
src/website/**/*.json text eol=lf
src/website/**/*.md text eol=lf
src/website/**/*.yml text eol=lf
src/website/**/*.yaml text eol=lf

# Store large video files through Git LFS instead of normal Git blobs.
# *.mp4 filter=lfs diff=lfs merge=lfs -text
# *.webm filter=lfs diff=lfs merge=lfs -text

# Exclude dependency, build, cache, and local-output directories from generated Git archives.
node_modules/ export-ignore
dist/ export-ignore
build/ export-ignore
coverage/ export-ignore
src/website/dist/ export-ignore
src/website/.vite/ export-ignore
src/website/node_modules/ export-ignore
src/website/.vercel/ export-ignore
.venv/ export-ignore
.venv_ludoxel/ export-ignore
tools/export_directory_markdown/output/ export-ignore
tools/format_python_source/.cache/ export-ignore
configs/ export-ignore
