graft assets
graft third-party
graft tools

include pyproject.toml
include README.md
include LICENSE

recursive-include src/ludoxel/presentation/interface/theme *.qss
recursive-include src/ludoxel/presentation/rendering/backends/opengl/shaders *.vert *.frag *.comp *.glsl
recursive-include src/ludoxel/presentation/rendering/backends/wgpu/shaders/sources *.vert *.frag *.comp *.glsl
recursive-include src/ludoxel/simulation/spaces/othello/resources *.json

global-exclude __pycache__ *.py[cod]
